export type VulnStatus = 'Critical' | 'High' | 'Medium'

export type Vulnerability = {
  cve: string
  name: string
  host: string
  owner: string
  epss: number
  identityRisk: number
  unified: number
  status: VulnStatus
  description: string
  vector: string
}

