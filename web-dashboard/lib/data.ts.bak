export type Severity = 'critical' | 'high' | 'medium' | 'low'

export function severityFromScore(score: number): Severity {
  if (score >= 0.7) return 'critical'
  if (score >= 0.5) return 'high'
  if (score >= 0.3) return 'medium'
  return 'low'
}

